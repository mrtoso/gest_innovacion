# --- Google Sheets (obligatorio en producción) ---
# ID de la hoja: lo que hay entre /d/ y /edit en la URL del libro.
GOOGLE_SHEET_ID=
# Email de la service account. Comparta la hoja con este email (permiso de Editor).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la service account (con los saltos de línea como \n).
GOOGLE_PRIVATE_KEY=

# --- Sitio ---
# URL pública para construir los enlaces (script `npm run links`).
APP_URL=http://localhost:3000
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
